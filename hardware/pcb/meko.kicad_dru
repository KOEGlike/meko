(version 1)

(rule "boot sd lenth and skew"
      (condition "A.hasNetclass('BOOT_SDMMC')")
      (constraint length (opt 30ps))
      (constraint skew (max 1ps))
)

(rule "DDR reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('DDR*') && ((A.intersectsArea('SAMA') && B.intersectsArea('SAMA')) || (A.intersectsArea('DDR') && B.intersectsArea('DDR')))")
)

(rule "SDMMC reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('SDMMC*') && A.intersectsArea('SAMA') && B.intersectsArea('SAMA')")
)

(rule "USB reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('USB') && A.intersectsArea('SAMA') && B.intersectsArea('SAMA')")
)
