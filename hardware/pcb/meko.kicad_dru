(version 1)

(rule "DDR clk length and skew"
	(condition "A.hasNetclass('DDR_CLOCK')")
	(constraint length (min 230.7ps)(opt 231ps)(opt 231.3ps))
	(constraint skew (min 1ps)(max 1ps))
)

(rule "DDR addr/ctl length and skew"
	(condition "A.hasNetclass('DDR_ADDR_CTL')")
	(constraint length (min 211ps)(opt 211.25ps)(opt 211.6ps))
	(constraint skew (max 1ps))
)

(rule "DDR lane0 length and skew"
	(condition "A.hasNetclass('DDR_LANE0')")
	(constraint length (min 229.4ps)(opt 229.75ps)(opt 230ps))
	(constraint skew (max 1ps))
)

(rule "DDR lane1 length and skew"
	(condition "A.hasNetclass('DDR_LANE1')")
	(constraint length (min 218ps)(opt 218.3ps)(max 218.6ps))
	(constraint skew (max 1ps))
)

(rule "DDR reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('DDR*') && A.intersectsArea('DDR')")
)

(rule "SAMA reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "(A.hasNetclass('DDR*') || A.hasNetclass('ASI*') || A.hasNetclass('UART*') || A.hasNetclass('SDMMC*') || A.hasNetclass('USB')) && A.intersectsArea('SAMA')")
)

(rule "WIRELESS reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "(A.hasNetclass('SDMMC_WL') || A.hasNetclass('UART_BT') || A.hasNetclass('ASI_BT')) && A.intersectsArea('WIRELESS')")
)

(rule "GND reduced clearance to special nets"
    (constraint clearance (min 0.1mm))
    (condition "B.NetName == 'GND'")
)
