(version 1)

(rule "boot sd length and skew"
	(condition "A.hasNetclass('BOOT_SDMMC')")
	(constraint length (opt 30ps))
	(constraint skew (max 1ps))
)

(rule "DDR clk length and skew"
	(condition "A.hasNetclass('DDR_CLOCK')")
	(constraint length (opt 242ps))
	(constraint skew (max 1ps))
)

(rule "DDR addr/ctl length and skew"
	(condition "A.hasNetclass('DDR_ADDR_CTL')")
	(constraint length (opt 222ps))
	(constraint skew (max 1ps))
)

(rule "DDR lane0 length and skew"
	(condition "A.hasNetclass('DDR_LANE0')")
	(constraint length (opt 241.5ps))
	(constraint skew (max 1ps))
)

(rule "DDR lane1 length and skew"
	(condition "A.hasNetclass('DDR_LANE1')")
	(constraint length (opt 229.5ps))
	(constraint skew (max 1ps))
)

(rule "DDR reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('DDR*') && A.intersectsArea('DDR') && B.intersectsArea('DDR')")
)

(rule "SAMA reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('DDR*') && A.intersectsArea('SAMA') && B.intersectsArea('SAMA')")
)

(rule "SDMMC reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('SDMMC*') && A.intersectsArea('SAMA') && B.intersectsArea('SAMA')")
)

(rule "USB reduced clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.hasNetclass('USB') && A.intersectsArea('SAMA') && B.intersectsArea('SAMA')")
)
